{
  "manifest_version": 3,
  "name": "豆瓣租房助手",
  "version": "0.2.0",
  "description": "在豆瓣小组里标记、筛选租房帖：价格、关键词、求租与重复帖过滤，可按工作地点的公交通勤时间筛选。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "豆瓣租房助手：我的标记与设置",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": ["storage"],
  "optional_host_permissions": ["https://restapi.amap.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.douban.com/group/*"],
      "js": ["shared/rules.js", "shared/storage.js", "content/panel.js", "content/list.js", "content/topic.js", "content/main.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
